{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gestpr-backend.vercel.app/api/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://gestpr-backend.vercel.app/download/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://gestpr-backend.vercel.app/public/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
