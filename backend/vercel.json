{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "",
  "rewrites": [
    { "source": "/", "destination": "/api/root" },
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/login", "destination": "/api/login" },
    { "source": "/download/:path*", "destination": "/api/download?path=download/:path*" },
    { "source": "/public/:path*", "destination": "/api/files?path=public/:path*" },
    { "source": "/api/(.*)", "destination": "/api?path=$1" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "src/**"
    },
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "src/**"
    },
    "api/files.js": {
      "maxDuration": 15,
      "memory": 256,
      "includeFiles": "src/public/**"
    },
    "api/download.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "src/models/**,src/pdf/**,src/public/**,src/controllers/**,src/middlewares/**,src/handlers/**,src/locale/**,src/settings/**,src/utils/**"
    },
    "api/login.js": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "src/models/coreModels/**"
    },
    "api/root.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/ping.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/health.js": {
      "maxDuration": 15,
      "memory": 256
    }
  }
}
