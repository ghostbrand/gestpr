{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "",
  "rewrites": [
    { "source": "/", "destination": "/api/root" },
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "src/**"
    },
    "api/root.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/ping.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/health.js": {
      "maxDuration": 15,
      "memory": 256
    }
  }
}
