{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src/**,node_modules/mongoose-autopopulate/**,node_modules/mongoose/**,node_modules/mongodb/**,node_modules/bson/**}"
    },
    "api/ping.js": {
      "maxDuration": 10,
      "memory": 128
    }
  }
}
