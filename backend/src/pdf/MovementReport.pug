doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    style.
      body {
        font-family: 'Segoe UI', Arial, sans-serif;
        font-size: 10px;
        color: #1e293b;
        margin: 0;
        padding: 12px;
      }
      h1 {
        font-size: 16px;
        margin: 0 0 4px 0;
        color: #0c4a6e;
      }
      .meta {
        font-size: 10px;
        color: #64748b;
        margin-bottom: 14px;
      }
      .band {
        background: linear-gradient(90deg, #0c4a6e 0%, #0369a1 55%, #ca8a04 100%);
        color: #fff;
        padding: 8px 12px;
        font-weight: 700;
        font-size: 11px;
        margin: 16px 0 8px 0;
        border-radius: 4px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
      }
      th {
        text-align: left;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        padding: 6px 8px;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #475569;
      }
      td {
        border: 1px solid #e2e8f0;
        padding: 5px 8px;
        vertical-align: top;
      }
      tr:nth-child(even) td { background: #fafafa; }
      .num { text-align: right; white-space: nowrap; }
      .totals {
        margin-top: 8px;
        padding: 10px 12px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 6px;
        font-size: 11px;
      }
      .totals strong { color: #92400e; }
  body
    h1 Relatório de movimentos
    .meta
      | #{periodLabel}
      if start && end
        |  · #{moment(start).format(dateFormat)} — #{moment(end).format(dateFormat)}
    .totals
      strong Resumo:
      |
      |  #{summary.invoiceCount} faturas (#{moneyFormatter(summary.invoiceTotal)})
      |  · #{summary.paymentCount} pagamentos (#{moneyFormatter(summary.paymentTotal)})
      |  · #{summary.quoteCount} orçamentos (#{moneyFormatter(summary.quoteTotal)})

    .band Faturas
    table
      thead
        tr
          th Nº
          th Data
          th Cliente
          th Estado
          th.num Total
      tbody
        each inv in invoices
          tr
            td #{inv.number}/#{inv.year}
            td= moment(inv.date).format(dateFormat)
            td= inv.client && inv.client.name ? inv.client.name : '—'
            td= inv.paymentStatus || '—'
            td.num= moneyFormatter(inv.total || 0)
        if invoices.length === 0
          tr
            td(colspan="5") —

    .band Pagamentos
    table
      thead
        tr
          th Nº
          th Data
          th Cliente
          th Fatura
          th.num Valor
      tbody
        each pay in payments
          tr
            td= pay.number
            td= moment(pay.date).format(dateFormat)
            td= pay.client && pay.client.name ? pay.client.name : '—'
            td
              if pay.invoice
                | #{pay.invoice.number}/#{pay.invoice.year}
              else
                | —
            td.num= moneyFormatter(pay.amount || 0)
        if payments.length === 0
          tr
            td(colspan="5") —

    .band Orçamentos
    table
      thead
        tr
          th Nº
          th Data
          th Cliente
          th Estado
          th.num Total
      tbody
        each q in quotes
          tr
            td #{q.number}/#{q.year}
            td= moment(q.date).format(dateFormat)
            td= q.client && q.client.name ? q.client.name : '—'
            td= q.status || '—'
            td.num= moneyFormatter(q.total || 0)
        if quotes.length === 0
          tr
            td(colspan="5") —
