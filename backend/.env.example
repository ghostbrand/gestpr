# Copy to `.env` / `.env.local` and fill values.
# `src/server.js` loads `.env` then `.env.local` (local overrides).

# Option A (recommended on Windows if `mongodb+srv` fails with querySrv errors):
# DATABASE="mongodb://USER:PASS@SHARD00:27017,SHARD01:27017,SHARD02:27017/gestp?ssl=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority"

# Option B (SRV):
# DATABASE="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/gestp?retryWrites=true&w=majority"

JWT_SECRET="change_me"
NODE_ENV="development"
PUBLIC_SERVER_FILE="http://localhost:8888/"

# URL pública do frontend (links nos e-mails de recuperação de palavra-passe)
PUBLIC_APP_URL="http://localhost:5173"

# E-mail: Resend (recomendado em dev) OU SMTP
RESEND_API=""
MAIL_FROM="noreply@example.com"
MAIL_TRANSPORT="resend"

# SMTP (se MAIL_TRANSPORT=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
