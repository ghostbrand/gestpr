# Local (npm run dev) — proxy para localhost:8888
# VITE_BACKEND_SERVER=
# VITE_FILE_BASE_URL=http://localhost:8888/

# Produção na Vercel (projeto gestpr-app) — Settings → Environment Variables
VITE_BACKEND_SERVER=https://gestpr-backend.vercel.app/
VITE_FILE_BASE_URL=https://gestpr-backend.vercel.app/
VITE_APP_URL=https://gestpr-app.vercel.app/
